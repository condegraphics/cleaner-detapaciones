RewriteEngine On

RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.cleanerdestapaciones\.com\.ar$ [NC]
RewriteRule ^ https://www.cleanerdestapaciones.com.ar%{REQUEST_URI} [R=301,L,NE]

RewriteRule ^index\.html$ https://www.cleanerdestapaciones.com.ar/ [R=301,L,NE]

# ============================================================================
# HARDENING CONDE GRAPHICS - Bloquear documentos internos
# Los .md son notas de trabajo/briefs internos, no contenido del sitio.
# ============================================================================
<IfModule mod_authz_core.c>
  <FilesMatch "\.(md|markdown)$">
    Require all denied
  </FilesMatch>
  <FilesMatch "^\.gitignore$">
    Require all denied
  </FilesMatch>
</IfModule>